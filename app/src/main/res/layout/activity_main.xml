<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp"
    tools:context=".MainActivity">

    <ListView
        android:id="@+id/listView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="#1A1A1A"
        android:divider="#333333"
        android:dividerHeight="1dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/audioStatusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/audioStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/audio_status"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/listView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/speakerStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/speaker_unavailable"
        android:textColor="#888888"
        android:textSize="10sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/audioStatusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/bluetoothStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bluetooth_disconnected"
        android:textColor="#888888"
        android:textSize="10sp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@+id/speakerStatusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonTestAudio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/test_audio"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:background="@drawable/button_rounded"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:minHeight="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="10dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@+id/bluetoothStatusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonBluetooth" />

    <Button
        android:id="@+id/buttonBluetooth"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/open_bluetooth"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:background="@drawable/button_rounded"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:minHeight="32dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="10dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@+id/bluetoothStatusText"
        app:layout_constraintStart_toEndOf="@+id/buttonTestAudio"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonReadMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/read_message"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:background="@drawable/button_rounded"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:minHeight="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@+id/buttonTestAudio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>